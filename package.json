{
  "name": "church-studio",
  "version": "0.32.0",
  "updateRepo": "calebaustin/church-studio",
  "private": true,
  "description": "Local desktop app: sermon video -> captioned, auto-centered 9:16 clips. Offline, no LLM required.",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n daemon,ui,app -c blue,magenta,green \"npm:dev:daemon\" \"npm:dev:ui\" \"npm:dev:app\"",
    "dev:daemon": "node --watch src/daemon/server.js",
    "dev:ui": "vite",
    "dev:app": "wait-on tcp:127.0.0.1:5173 tcp:127.0.0.1:4317 && cross-env SC_UI_URL=http://127.0.0.1:5173 SC_EXTERNAL_DAEMON=1 electron .",
    "build": "vite build",
    "start": "vite build && electron .",
    "daemon": "node src/daemon/server.js",
    "test": "node --test test/",
    "build:app": "scripts/build-app.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@iconify-json/lucide": "^1.2.158",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/tabler": "^1.2.46",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^38.0.0",
    "electron-builder": "^26.18.0",
    "jspdf": "4.2.1",
    "lucide-react": "^1.74.0",
    "pptxgenjs": "4.0.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true,
    "@ffprobe-installer/darwin-arm64@5.0.1": true
  },
  "productName": "Church Studio",
  "build": {
    "appId": "app.churchstudio.desktop",
    "productName": "Church Studio",
    "directories": {
      "output": "dist/release",
      "buildResources": "assets/build"
    },
    "asar": false,
    "files": [
      "electron/**",
      "src/daemon/**",
      "dist/ui/**",
      "package.json",
      "CHANGELOG.md",
      "!node_modules/ffmpeg-static/**",
      "!node_modules/@ffprobe-installer/**",
      "!node_modules/@expo-google-fonts/**",
      "!**/node_modules/**/*.d.ts",
      "!**/node_modules/**/*.d.mts",
      "!**/node_modules/**/*.d.cts",
      "!**/node_modules/**/*.map",
      "!**/node_modules/**/*.md"
    ],
    "extraResources": [
      {
        "from": "build/bin",
        "to": "bin"
      },
      {
        "from": "build/sc-media",
        "to": "sc-media"
      },
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "fonts/**",
          "build/icon.png",
          "build/trayTemplate*.png",
          "bible/**",
          "icons/**"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg"
      ],
      "identity": null,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Church Studio",
      "artifactName": "Church-Studio-Mac-${arch}.${ext}"
    }
  }
}
